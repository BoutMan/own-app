{
  "expo": {
    "name": "Own",
    "slug": "own",
    "scheme": "own",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.own.app"
    },
    "android": {
      "package": "com.own.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#2A2A2A"
        }
      ],
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Own uses the camera for your progress photos. They stay in the app's locked vault on this phone and are never uploaded.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Own uses Face ID to lock your photo vault."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Own adds your session times to your calendar, only if you ask it to."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
